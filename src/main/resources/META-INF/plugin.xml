<idea-plugin>
    <id>com.github.rashed94x.clockifyplugin</id>
    <name>Clockify</name>
    <vendor>rashed94x</vendor>
    <description><![CDATA[
        Log time to Clockify directly from your JetBrains IDE.
        Configure your API token and default project in Settings → Tools → Clockify,
        then log time after each commit via the automatic dialog.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">

        <projectConfigurable
            parentId="tools"
            instance="com.github.rashed94x.clockifyplugin.settings.ClockifySettingsConfigurable"
            id="clockify.settings"
            displayName="Clockify"/>

        <projectService
            serviceImplementation="com.github.rashed94x.clockifyplugin.settings.ClockifyProjectSettings"/>

        <checkinHandlerFactory
            implementation="com.github.rashed94x.clockifyplugin.vcs.ClockifyCheckinHandlerFactory"/>

        <notificationGroup
            id="Clockify"
            displayType="BALLOON"
            isLogByDefault="false"/>

        <toolWindow
            id="Clockify"
            anchor="right"
            factoryClass="com.github.rashed94x.clockifyplugin.toolwindow.ClockifyToolWindowFactory"
            secondary="false"/>

    </extensions>
</idea-plugin>
