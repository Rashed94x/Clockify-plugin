<idea-plugin>
    <id>no.paral.clockifyplugin</id>
    <name>Clockify</name>
    <vendor>Paral</vendor>
    <description><![CDATA[
        Log time to Clockify directly from your JetBrains IDE.
        Configure your API token and default project in Settings → Tools → Clockify,
        then log time after each commit or push via the automatic dialog.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="git4idea.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">

        <projectConfigurable
                parentId="tools"
                instance="no.paral.clockifyplugin.settings.ClockifySettingsConfigurable"
                id="clockify.settings"
                displayName="Clockify"/>

        <notificationGroup
                id="Clockify"
                displayType="BALLOON"
                isLogByDefault="false"
                bundle="messages.ClockifyBundle"
                key="notification.group.clockify"/>

        <toolWindow
                id="Clockify"
                anchor="right"
                icon="/icons/MyIcon.svg"
                factoryClass="no.paral.clockifyplugin.toolwindow.ClockifyToolWindowFactory"
                secondary="false"/>

    </extensions>
</idea-plugin>
